<div style="min-height:100%;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body);padding:0 20px 64px;">
  <div style="max-width:760px;margin:0 auto;">
    <Layouts.site_nav locale={@locale} />

    <main id="main-content">
      <div style="padding:36px 0 28px;border-bottom:1px solid var(--color-neutral-800);">
        <div style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--color-chakra);margin-bottom:10px;">
          {gettext("field notes")}
        </div>
        <h1 style="font-family:var(--font-heading);font-weight:500;font-size:clamp(28px,5vw,40px);line-height:1.15;letter-spacing:-0.02em;margin:0 0 10px;color:var(--color-neutral-100);">
          TIL
        </h1>
        <p style="font-size:15px;line-height:1.6;color:var(--color-neutral-400);margin:0;max-width:52ch;">
          {gettext("Today I learned: small, quick notes that didn't earn a full scroll.")}
        </p>
      </div>

      <div style="padding:8px 0;">
        <ul style="list-style:none;margin:0;padding:0;">
          <li :for={post <- @posts}>
            <a
              href={~p"/posts/#{post.id}"}
              class="mission-row"
              style="display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px 18px;align-items:baseline;padding:16px 8px;border-bottom:1px solid var(--color-neutral-800);color:inherit;"
            >
              <span style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--color-neutral-600);white-space:nowrap;">{post.date}</span>
              <span>
                <span style="display:block;font-size:17px;color:var(--color-neutral-100);margin-bottom:4px;">{post.title}</span>
                <span style="display:block;font-size:15px;color:var(--color-neutral-400);line-height:1.6;max-width:65ch;">{post.description}</span>
              </span>
            </a>
          </li>
        </ul>

        <p
          :if={@posts == []}
          style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;color:var(--color-neutral-600);padding:16px 8px;"
        >
          {gettext("nothing logged yet")}
        </p>
      </div>
    </main>

    <Layouts.site_footer />
  </div>
</div>
