<div style="min-height:100%;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body);padding:0 20px 64px;">
  <div style="max-width:760px;margin:0 auto;">
    <Layouts.site_nav locale={@locale} />

    <div style="padding:36px 0 0;">
      <a
        :if={"til" in @post.tags}
        href="/til"
        style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--color-neutral-500);"
      >
        ← all til
      </a>
      <a
        :if={"til" not in @post.tags}
        href="/#writing"
        style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--color-neutral-500);"
      >
        ← all scrolls
      </a>
    </div>

    <div :if={@post.draft} style="padding:18px 0 28px;border-bottom:1px solid var(--color-neutral-800);opacity:0.55;">
      <div style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--color-neutral-600);margin-bottom:10px;">
        queued
      </div>
      <h1 style="font-family:var(--font-heading);font-weight:500;font-size:clamp(28px,5vw,40px);line-height:1.15;letter-spacing:-0.02em;margin:0 0 12px;color:var(--color-neutral-100);">
        {@post.title}
      </h1>
      <p style="font-size:16px;color:var(--color-neutral-400);margin:0;">
        {@post.description}
      </p>
      <p style="font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--color-neutral-600);margin:14px 0 0;">
        coming soon
      </p>
    </div>

    <div :if={!@post.draft} style="padding:18px 0 28px;border-bottom:1px solid var(--color-neutral-800);">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--color-neutral-600);margin-bottom:10px;">
        <span>{@post.date}</span>
        <span>·</span>
        <span style="color:var(--color-chakra);">{Sjr.Blog.rank(@post)} · {Sjr.Blog.reading_time_minutes(
          @post
        )} min</span>
      </div>
      <h1 style="font-family:var(--font-heading);font-weight:500;font-size:clamp(28px,5vw,40px);line-height:1.15;letter-spacing:-0.02em;margin:0 0 12px;color:var(--color-neutral-100);">
        {@post.title}
      </h1>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        <span :for={tag <- @post.tags} class="tag tag-neutral">{tag}</span>
      </div>
      <% translation = Sjr.Blog.find_translation(@post) %>
      <a
        :if={translation}
        href={~p"/posts/#{translation.id}"}
        style="display:inline-block;margin-top:12px;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:var(--color-neutral-500);"
      >
        {Sjr.Blog.translation_link_label(translation)}
      </a>
    </div>

    <.post_cover icon={@post.icon} />

    <div
      :if={!@post.draft}
      class="post-body"
      style="padding:32px 0;font-size:16px;line-height:1.7;color:var(--color-neutral-300);"
    >
      {raw(@post.body)}
    </div>

    <Layouts.site_footer />
  </div>
</div>
