<!DOCTYPE html>
<html lang={if assigns[:locale] == "pt-br", do: "pt-BR", else: "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <% site_description =
      "Senior Backend Software Engineer. Node.js, TypeScript, Elixir, distributed systems. São Paulo, Brazil." %>
    <% og_title = assigns[:og_title] || "Simão Júnior · simaojunior.dev" %>
    <% og_description = assigns[:og_description] || site_description %>
    <% og_url = assigns[:og_url] || "https://simaojunior.dev" %>
    <% og_type = assigns[:og_type] || "website" %>

    <meta name="description" content={og_description} />
    <meta :if={assigns[:noindex]} name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={og_url} />

    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/images/favicon-32x32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/images/favicon-16x16.png"} />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />

    <meta property="og:type" content={og_type} />
    <meta property="og:site_name" content="simaojunior.dev" />
    <meta property="og:title" content={og_title} />
    <meta property="og:description" content={og_description} />
    <meta property="og:url" content={og_url} />
    <meta
      :if={assigns[:og_published_time]}
      property="article:published_time"
      content={@og_published_time}
    />
    <meta :for={tag <- assigns[:og_tags] || []} property="article:tag" content={tag} />
    <meta property="og:image" content={"https://simaojunior.dev" <> ~p"/images/og-image.png?v=2"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og_title} />
    <meta name="twitter:description" content={og_description} />
    <meta
      name="twitter:image"
      content={"https://simaojunior.dev" <> ~p"/images/og-image.png?v=2"}
    />

    <script>
      (function () {
        var theme = localStorage.getItem("sj-theme");
        document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
      })();
    </script>
    <.live_title default="Simão Júnior" suffix=" · simaojunior.dev">
      {assigns[:page_title]}
    </.live_title>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={~p"/fonts/jetbrains-mono-latin.woff2"}
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{gettext("Skip to content")}</a>
    {@inner_content}

    <div
      id="command-menu-data"
      data-items={Jason.encode!(SjrWeb.Layouts.command_menu_items())}
      hidden
    >
    </div>
    <button
      id="command-menu-trigger"
      type="button"
      class="command-menu-trigger"
      aria-label={gettext("Open command menu")}
    >
      <span>{gettext("Press")}</span><kbd>⌘ P</kbd>
    </button>
    <div id="command-menu-overlay" class="cmd-overlay" hidden>
      <div class="cmd-panel" role="dialog" aria-modal="true" aria-label={gettext("Command menu")}>
        <input
          id="command-menu-input"
          class="cmd-input"
          type="text"
          placeholder={gettext("Type to search...")}
          autocomplete="off"
          spellcheck="false"
          aria-label={gettext("Search")}
        />
        <ul id="command-menu-list" class="cmd-list" role="listbox"></ul>
        <div class="cmd-footer">
          <span>{gettext("ESC to close")}</span>
          <span><kbd>^J</kbd><kbd>^K</kbd> {gettext("navigate")} ·
          <kbd>&crarr;</kbd> {gettext("open")}</span>
        </div>
      </div>
    </div>
  </body>
</html>
